*.env
*.env.*
*.pem
*.key
*.key.password
*.keystore
*.jks
*.apk
*.aab
latest.json.sig
*.sig
*.p12
*.pfx
*.sqlite
*.sqlite3
*.db
*.db-shm
*.db-wal
